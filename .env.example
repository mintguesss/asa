# 複製成 .env 再填入。全部都可以留空：沒填的功能會自動略過。
# Copy to .env and fill in what you need. Everything is optional.

# ---------- 伺服器 ----------
PORT=8787
# 推播訊息的語言：zh 或 en（網頁介面的語言在右上角切換）
ASA_LANG=zh
# 手機用的存取碼：留空的話第一次啟動會自動產生
PHONE_TOKEN=
# 手機連這台電腦用的網址；留空會自動偵測（Tailscale IP → 區網 IP）
PUBLIC_URL=

# ---------- 每日推播 ----------
# 每晚推播明日預告並重排鬧鐘的時間、早上簡報的時間
EVENING_TIME=21:30
MORNING_TIME=08:00

# ---------- 通知管道（填哪個就送哪個）----------
# Discord：頻道設定 → 整合 → Webhook → 複製網址
DISCORD_WEBHOOK_URL=
# LINE Messaging API（LINE Notify 已停止服務）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
# Telegram：跟 @BotFather 建立 bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy：例如 https://ntfy.sh/your-topic
NTFY_URL=
# 自訂 Webhook：會 POST {"text": "..."}
WEBHOOK_URL=

# ---------- 資料來源（抓到的東西先進「審核」）----------
SYNC_INTERVAL_MINUTES=30
# 信任的來源可以跳過審核，直接加進行事曆／待辦。填來源名稱，逗號分隔，例：ics 或 ics,eeclass
AUTO_APPROVE=

# iCalendar 訂閱：Google 日曆、Outlook、Moodle、Canvas…  格式：名稱=網址,名稱=網址
ICS_EVENT_URLS=
ICS_DEADLINE_URLS=
ICS_DAYS_AHEAD=60
# 重複行程（每週開會之類）只展開未來幾天
ICS_REPEAT_DAYS_AHEAD=14

# eeClass（台灣多所大學使用的教學平台）。例：https://ncueeclass.ncu.edu.tw
EECLASS_URL=
EECLASS_ACCOUNT=
EECLASS_PASSWORD=
